<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permesso normale: gateway e sottorete riconoscono la rete di casa per le credenziali di Kodi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Player di Android per Kodi (KodiPlayer): servizio in primo piano con una MediaSession -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Aggiornamento con un tocco: l'app passa l'APK nuovo all'installatore (Android chiede il consenso la prima volta) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- usesCleartextTraffic: Kodi espone l'API JSON-RPC solo in HTTP sulla rete locale -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Couch Cast"
        android:theme="@style/App"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Condividi → Couch Cast da Chrome o da un'altra app: il link arriva in EXTRA_TEXT (vedi openShared).
                 singleTask: se l'app è già aperta il link arriva lì (onNewIntent) invece di aprirne un'altra -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Pressione lunga sul riquadro Couch Cast della tendina: apre il telecomando (openRemote) -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- Tasti di Kodi nella tendina e sulla schermata di blocco: lo avvia l'Activity quando Kodi riproduce -->
        <service
            android:name=".KodiPlayer"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Timer di spegnimento tenuto dal telefono, quando la Fire TV non risponde in ADB -->
        <receiver
            android:name=".TimerReceiver"
            android:exported="false" />
        <!-- Riquadro Couch Cast delle impostazioni rapide -->
        <service
            android:name=".KodiTile"
            android:exported="true"
            android:icon="@drawable/ic_cast"
            android:label="Couch Cast"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
