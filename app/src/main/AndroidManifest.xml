<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permesso normale: gateway e sottorete riconoscono la rete di casa per le credenziali di Kodi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- usesCleartextTraffic: Kodi espone l'API JSON-RPC solo in HTTP sulla rete locale -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Couch Cast"
        android:theme="@style/App"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Condividi → Couch Cast da Chrome o da un'altra app: il link arriva in EXTRA_TEXT (vedi openShared).
                 singleTask: se l'app è già aperta il link arriva lì (onNewIntent) invece di aprirne un'altra -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
