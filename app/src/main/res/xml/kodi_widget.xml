<?xml version="1.0" encoding="utf-8"?>
<!-- Widget sulla Home (KodiWidget): 4×2 celle, si allarga e si stringe fino a 2×1. Si aggiorna quando l'app o il player della
     tendina leggono Kodi; da solo ogni 30 minuti al massimo, così con lo schermo spento non consuma -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget"
    android:minWidth="110dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
